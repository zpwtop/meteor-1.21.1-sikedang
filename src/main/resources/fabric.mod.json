{
  "schemaVersion": 1,
  "id": "hachimi-meteor-standalone",
  "version": "1.0.0",
  "name": "Hachimi Meteor Standalone",
  "description": "Ten independent Hachimi and Slime modules for Minecraft 1.21.4 / Meteor 1.21.4-42.",
  "authors": [
    "Hachimi Addon contributors"
  ],
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "dev.hachimi.standalone.HachimiAddon"
    ]
  },
  "depends": {
    "java": ">=21",
    "minecraft": "1.21.4",
    "fabricloader": ">=0.16.9",
    "meteor-client": "1.21.4-42"
  },
  "custom": {
    "meteor-client:color": "255,170,70"
  },
  "mixins": [
    "hachimi-standalone.mixins.json"
  ]
}